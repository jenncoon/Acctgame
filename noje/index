}

// LEDGER
function buildLedger(){
  const ledger={};
  gameTransactions.forEach(tx=>{tx.entries.forEach(e=>{if(!ledger[e.account])ledger[e.account]={debit:0,credit:0};ledger[e.account].debit+=e.debit;ledger[e.account].credit+=e.credit;});});
  return ledger;
}
function getBal(acct,ledger){const e=ledger[acct]||{debit:0,credit:0};return DEBIT_NORMAL.has(acct)?e.debit-e.credit:e.credit-e.debit;}
function getSortedAccounts(ledger){return sortByCOA(Object.keys(ledger));}

function buildTxTable(){
