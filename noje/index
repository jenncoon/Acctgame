// BOARD
function buildBoard(){
  const board=document.getElementById('monopoly-board'); board.innerHTML='';
  const gp={};
  for(let i=0;i<=10;i++) gp[i]={row:11,col:i+1,side:'bottom'};
  for(let i=11;i<=19;i++) gp[i]={row:11-(i-10),col:11,side:'right-col'};
  for(let i=20;i<=30;i++) gp[i]={row:1,col:11-(i-20),side:'top'};
  for(let i=31;i<=39;i++) gp[i]={row:i-29,col:1,side:'left-col'};
  SPACES.forEach(sp=>{
    const pos=gp[sp.id]; const el=document.createElement('div');
    el.className=`space ${pos.side}${sp.group==='corner'?' corner':''}`;
    el.id=`space-${sp.id}`; el.style.gridRow=pos.row; el.style.gridColumn=pos.col;
    el.setAttribute('aria-label',sp.name);
    let inner='';
    if(sp.color&&STRIP[sp.color]) inner+=`<div class="color-dot ${STRIP[sp.color]}" aria-hidden="true"></div>`;
    inner+=`<span class="space-icon" aria-hidden="true">${sp.icon}</span>`;
    inner+=`<span class="space-name">${sp.name}</span>`;
    if(sp.price>0) inner+=`<span class="space-price">$${sp.price}</span>`;
    el.innerHTML=inner; board.appendChild(el);
  });
  const center=document.createElement('div');
  center.className='board-center'; center.style.gridRow='2/11'; center.style.gridColumn='2/11';
  center.innerHTML=`<div class="center-title">Boardwalk<br>Books LLC</div><div class="center-sub">Crestwood Heights</div><div class="center-sub" style="color:var(--violet);font-weight:700;margin-top:4px;">Accounting Cycle Game</div>`;
  board.appendChild(center); renderTokens();
}

