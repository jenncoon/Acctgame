// IFRS terminology map
const IFRS_TERMS={
  'Accounts Receivable':'Trade Receivables',
  'Accounts Payable':'Trade Payables',
};
const GAAP_TERMS={
  'Trade Receivables':'Accounts Receivable',
  'Trade Payables':'Accounts Payable',
};

// Return account name based on current standard
function acctName(name){
  if(accountingStandard==='ifrs'&&IFRS_TERMS[name]) return IFRS_TERMS[name];
  return name;
}
// Reverse lookup: given display name, return COA name
function coaName(displayName){
  if(accountingStandard==='ifrs'&&GAAP_TERMS[displayName]) return GAAP_TERMS[displayName];
  return displayName;
}

