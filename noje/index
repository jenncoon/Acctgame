  ACCOUNTS.forEach(a=>{if(excludeClosing&&a.group==='Closing')return;if(!grps[a.group])grps[a.group]=[];grps[a.group].push(a.name);});
  let h=`<select id="${id}" aria-label="${lbl}"><option value="">-- Select Account --</option>`;
  Object.entries(grps).forEach(([g,ns])=>{h+=`<optgroup label="${g}">`;ns.forEach(n=>{
    // Display IFRS name in dropdown but store COA name as value for consistent ledger lookup
    const displayName=acctName(n);
    h+=`<option value="${n}"${n===val?' selected':''}>${displayName}</option>`;
  });h+=`</optgroup>`;});
  return h+'</select>';
}
function sortByCOA(accts){return [...accts].sort((a,b)=>COA_ORDER.indexOf(a)-COA_ORDER.indexOf(b));}

