function acknowledgeCard(){
  document.getElementById('card-overlay').classList.remove('active');
  // If this was a Property Management card, route to its handler
  if(pendingPropCard){const c=pendingPropCard;pendingPropCard=null;processPropMgmtCard(c);return;}
  const card=pendingCard; let entries=[], cashChange=0, cardDesc=null;
  switch(card.type){
    case 'revenue':
      entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Service Revenue',debit:0,credit:card.amount}]; cashChange=card.amount; break;
    case 'rental-revenue': // FIX 1
      entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Rental Revenue',debit:0,credit:card.amount}]; cashChange=card.amount; break;
    case 'expense':
      entries=[{account:card.acct,debit:card.amount,credit:0},{account:'Cash',debit:0,credit:card.amount}]; cashChange=-card.amount; break;
    case 'loan':
      entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Notes Payable',debit:0,credit:card.amount}]; cashChange=card.amount; break;
    case 'deferred':
      entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Deferred Revenue',debit:0,credit:card.amount}]; cashChange=card.amount; break;
    case 'equity':
      entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Common Stock',debit:0,credit:card.amount}]; cashChange=card.amount; break;
    case 'dividend':
      entries=[{account:'Dividends',debit:card.amount,credit:0},{account:'Cash',debit:0,credit:card.amount}]; cashChange=-card.amount; break;
    case 'supplies-credit': // FIX 2: Dr. Supplies (asset) / Cr. AP
      entries=[{account:'Supplies',debit:card.amount,credit:0},{account:'Accounts Payable',debit:0,credit:card.amount}];
      cashChange=0; suppliesOnBooks=true; break;
    case 'ar-collect':{
      // Guard: only collect AR if there is an actual AR balance to collect
      const arLedger=buildLedger();
      const arBal=arLedger['Accounts Receivable']?(arLedger['Accounts Receivable'].debit-arLedger['Accounts Receivable'].credit):0;
      if(arBal<=0){
        // No AR balance - convert to service revenue cash collection instead
        entries=[{account:'Cash',debit:card.amount,credit:0},{account:'Service Revenue',debit:0,credit:card.amount}];
        cardDesc='<strong>Card drawn:</strong> No outstanding receivables on file. Collected $'+card.amount+' cash for services rendered.';
      } else {
        entries=[{account:'Cash',debit:card.amount,credit:0},{account:acctName('Accounts Receivable'),debit:0,credit:card.amount}];
      }
      cashChange=card.amount; break;}
  }
  showJE({type:'card',desc:cardDesc||`<strong>Card drawn:</strong> ${card.text}`,correctEntries:entries,
    onComplete:()=>{playerCash+=cashChange;renderScoreboard();addToLog(`Card: ${cashChange>=0?'+':''}$${cashChange}`);endTurn();}});
}

// JE MODAL (account + increase/decrease, order-independent, no dollar amount)
const JE_MAX=2;
let jeConfig=null;
function showJE(config){
  jeConfig=config;
  jeCorrectEntries=config.correctEntries; jeOnComplete=config.onComplete; jeCurrentAttempt=0;
  document.getElementById('je-desc').innerHTML=config.desc;
  document.getElementById('je-attempt-note').textContent=`Attempt 1 of ${JE_MAX}`;
  const tbody=document.getElementById('je-tbody'); tbody.innerHTML='';
  const row1=document.createElement('tr');
  row1.innerHTML=`<td>${acctSelectHTML('je-acct-1','Account 1')}</td><td>${changeSelectHTML('je-dir-1','Account 1: increase or decrease')}</td>`;
  tbody.appendChild(row1);
  const row2=document.createElement('tr');
  row2.innerHTML=`<td>${acctSelectHTML('je-acct-2','Account 2')}</td><td>${changeSelectHTML('je-dir-2','Account 2: increase or decrease')}</td>`;
  tbody.appendChild(row2);
  const fb=document.getElementById('je-feedback'); fb.className='je-feedback'; fb.textContent='';
  document.getElementById('je-submit-btn').style.display='block';
  const contBtn=document.getElementById('je-continue-btn');
  contBtn.style.display='none';
  contBtn.className='modal-btn success';
  contBtn.textContent='Continue \u2192';
  document.getElementById('je-overlay').classList.add('active');
  setTimeout(()=>document.getElementById('je-acct-1')?.focus(),300);
}

function submitJE(){
  jeCurrentAttempt++;
  const acct1=document.getElementById('je-acct-1').value, dir1=document.getElementById('je-dir-1').value;
  const acct2=document.getElementById('je-acct-2').value, dir2=document.getElementById('je-dir-2').value;
  const fb=document.getElementById('je-feedback');
  if(!acct1||!dir1||!acct2||!dir2){fb.className='je-feedback wrong show';fb.textContent='Please select both accounts and choose increase or decrease for each.';jeCurrentAttempt--;return;}
  if(acct1===acct2){fb.className='je-feedback wrong show';fb.textContent='Choose two different accounts, this transaction affects two separate accounts.';jeCurrentAttempt--;return;}
  const expected=jeCorrectEntries.map(e=>({account:e.account,change:expectedChange(e)}));
  const student=[{account:acct1,change:dir1},{account:acct2,change:dir2}];
  const matchAB=student[0].account===expected[0].account&&student[0].change===expected[0].change&&student[1].account===expected[1].account&&student[1].change===expected[1].change;
  const matchBA=student[0].account===expected[1].account&&student[0].change===expected[1].change&&student[1].account===expected[0].account&&student[1].change===expected[0].change;
  const ok=matchAB||matchBA;
  const describe=()=>expected.map(e=>`${acctName(e.account)} ${e.change==='increase'?'increases':'decreases'}`).join(' and ');
  if(ok){
    const ptsFirst=jeConfig.ptsFirst||2, ptsSecond=jeConfig.ptsSecond||1;
    const pts=jeCurrentAttempt===1?ptsFirst:ptsSecond;
    fb.className='je-feedback correct show';
    fb.innerHTML=`<strong>Correct!</strong> ${describe()}. (+${pts} pts)`;
    if(!jeConfig.skipLedger){
      cycleScores.je+=pts;
      gameTransactions.push({desc:document.getElementById('je-desc').textContent,entries:jeCorrectEntries,correct:true,pts});
    }
    if(jeConfig.onScore) jeConfig.onScore(pts);
    document.getElementById('je-submit-btn').style.display='none';
    const contBtn=document.getElementById('je-continue-btn');
    contBtn.className='modal-btn success';
    contBtn.textContent='Correct, Continue \u2192';
    contBtn.style.display='block';
    contBtn.focus();
  } else {
    document.getElementById('je-attempt-note').textContent=`Attempt ${jeCurrentAttempt} of ${JE_MAX}`;
    if(jeCurrentAttempt>=JE_MAX){
      fb.className='je-feedback hint show';
      fb.innerHTML=`<strong>Correct entry:</strong> ${describe()}.`;
      if(!jeConfig.skipLedger){
        gameTransactions.push({desc:document.getElementById('je-desc').textContent,entries:jeCorrectEntries,correct:false,pts:0});
      }
      if(jeConfig.onScore) jeConfig.onScore(0);
      document.getElementById('je-submit-btn').style.display='none';
      const contBtn=document.getElementById('je-continue-btn');
      contBtn.className='modal-btn reveal';
      contBtn.textContent='Not Correct, Continue \u2192';
      contBtn.style.display='block';
      contBtn.focus();
    } else {
      fb.className='je-feedback wrong show';
      fb.innerHTML=`<strong>Not quite.</strong> Check which two accounts are affected and whether each one increases or decreases. You have ${JE_MAX-jeCurrentAttempt} attempt(s) remaining.`;
    }
  }
}
