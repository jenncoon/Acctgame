function computeIS(){
  const ledger=window._p6Ledger;
  const REVS=['Rental Revenue','Service Revenue'];
  const EXPS=['Advertising Expense','Depreciation Expense','Insurance Expense','Interest Expense','Legal Expense','Luxury Tax Expense','Rent Expense','Repairs Expense','Supplies Expense','Tax Expense','Utilities Expense'];
  // Read what student entered for revenues and expenses
  let totalRev=0, totalExp=0;
  const isRowCount=window._p6isAccounts.length+1;
  for(let i=0;i<isRowCount;i++){
    const acct=document.getElementById(`is-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`is-amt-${i}`)?.value)||0;
    if(!acct||amt===0)continue;
    if(REVS.includes(acct)) totalRev+=amt;
    if(EXPS.includes(acct)) totalExp+=amt;
  }
  const ni=totalRev-totalExp;
  document.getElementById('is-ni-computed').textContent=ni>=0?`$${ni.toLocaleString()}`:`($${Math.abs(ni).toLocaleString()})`;
  document.getElementById('re-ni-display').textContent=ni>=0?`$${ni.toLocaleString()}`:`($${Math.abs(ni).toLocaleString()})`;
  window._p6ComputedNI=ni;
  // Update RE ending
  updateREEnding();
  const fb=document.getElementById('is-calc-feedback');
  fb.className='je-feedback correct show';
  fb.textContent=`Net Income calculated: ${ni>=0?'$'+ni.toLocaleString():'($'+Math.abs(ni).toLocaleString()+')'}. This has been added to your Statement of Retained Earnings.`;
}

function updateREEnding(){
  const ni=window._p6ComputedNI||0;
  const divAmt=parseFloat(document.getElementById('re-amt-0')?.value)||0;
  const endRE=ni-divAmt;
  document.getElementById('re-ending-display').textContent=endRE>=0?`$${endRE.toLocaleString()}`:`($${Math.abs(endRE).toLocaleString()})`;
  window._p6ComputedEndRE=endRE;
}

function computeBS(){
  const ledger=window._p6Ledger;
  const ASSETS=['Cash','Accounts Receivable','Supplies','Prepaid Insurance','Property Asset','Accumulated Depreciation'];
  const LIABS=['Accounts Payable','Notes Payable','Interest Payable','Deferred Revenue'];
  const EQ=['Common Stock','Retained Earnings'];
  let totalAssets=0, totalLE=0;

  // Read asset section rows
  const assetRowCount=window._p6AssetAccounts.length;
  for(let i=0;i<assetRowCount;i++){
    const acct=document.getElementById(`bsa-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`bsa-amt-${i}`)?.value)||0;
    if(!acct||amt===0)continue;
    if(acct==='Accumulated Depreciation') totalAssets-=amt;
    else totalAssets+=amt;
  }

  // Read liab+equity section rows
  const liabEqRowCount=window._p6LiabEqAccounts.length;
  for(let i=0;i<liabEqRowCount;i++){
    const acct=document.getElementById(`bsle-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`bsle-amt-${i}`)?.value)||0;
    if(!acct||amt===0)continue;
    if(LIABS.includes(acct)||EQ.includes(acct)) totalLE+=amt;
  }

  document.getElementById('bs-total-assets').textContent=`$${totalAssets.toLocaleString()}`;
  document.getElementById('bs-total-le').textContent=`$${totalLE.toLocaleString()}`;
  window._p6ComputedAssets=totalAssets; window._p6ComputedLE=totalLE;
  const balanced=Math.abs(totalAssets-totalLE)<1;
  const chk=document.getElementById('bs-balance-check');
  if(totalAssets>0||totalLE>0){
    chk.style.color=balanced?'var(--green)':'var(--red)';
    chk.textContent=balanced?'Balance Sheet is in balance!':'Balance Sheet does not balance. Check your accounts and amounts.';
  }
  const fb=document.getElementById('bs-calc-feedback');
  fb.className=`je-feedback ${balanced?'correct':'wrong'} show`;
  fb.textContent=balanced?`Total Assets: $${totalAssets.toLocaleString()} = Total Liabilities + Equity: $${totalLE.toLocaleString()}. In balance!`:`Total Assets ($${totalAssets.toLocaleString()}) do not equal Total Liabilities + Equity ($${totalLE.toLocaleString()}). Review your accounts.`;
}

function checkAllStatements(){
  const ledger=window._p6Ledger;
  const REVS=['Rental Revenue','Service Revenue'];
  const EXPS=['Advertising Expense','Depreciation Expense','Insurance Expense','Interest Expense','Legal Expense','Luxury Tax Expense','Rent Expense','Repairs Expense','Supplies Expense','Tax Expense','Utilities Expense'];
  const ASSETS=['Cash','Accounts Receivable','Supplies','Prepaid Insurance','Property Asset','Accumulated Depreciation'];
  const LIABS=['Accounts Payable','Notes Payable','Interest Payable','Deferred Revenue'];
  const isAccounts=window._p6isAccounts; // accounts that actually have balances
  const bsAccounts=window._p6bsAccounts;
  let correct=0, total=0;

  // Check IS rows
  const isRowCount=isAccounts.length+1;
  // Build a set of what SHOULD be on IS with correct amounts
  const isExpected={};
  isAccounts.forEach(a=>isExpected[a]=Math.abs(getBal(a,ledger)));

  // Track which expected accounts were found correctly
  const isFound={};
  for(let i=0;i<isRowCount;i++){
    const acct=document.getElementById(`is-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`is-amt-${i}`)?.value)||0;
    const row=document.getElementById(`is-row-${i}`);
    if(!acct&&amt===0){continue;} // empty extra row - skip
    total++;
    const expectedAmt=isExpected[acct];
    const acctCorrect=[...REVS,...EXPS].includes(acct)&&isExpected.hasOwnProperty(acct);
    const amtCorrect=expectedAmt!==undefined&&Math.abs(amt-expectedAmt)<1;
    if(acctCorrect&&amtCorrect){
      correct++; isFound[acct]=true;
      if(row){row.style.background='#e8f5e9';row.style.outline='2px solid var(--green)';}
    } else {
      if(row){row.style.background='#fce4ec';row.style.outline='2px solid var(--red)';}
    }
  }

  // Check RE: Dividends row
  total++;
  const reDDAct=document.getElementById('re-dd-0')?.value;
  const reAmt=parseFloat(document.getElementById('re-amt-0')?.value)||0;
  const divBal=window._p6divBal;
  const reRow=document.getElementById('re-div-row');
  if(reDDAct==='Dividends'&&Math.abs(reAmt-divBal)<1){
    correct++;
    if(reRow){reRow.style.background='#e8f5e9';reRow.style.outline='2px solid var(--green)';}
  } else {
    if(reRow){reRow.style.background='#fce4ec';reRow.style.outline='2px solid var(--red)';}
  }

  // Check BS asset rows
  const assetAccounts=window._p6AssetAccounts;
  const liabEqAccounts=window._p6LiabEqAccounts;
  const bsExpected={};
  // Use raw getBal so deficit RE (negative) is handled correctly
  [...assetAccounts,...liabEqAccounts].forEach(a=>{
    const bal=getBal(a,ledger);
    // For Accumulated Depreciation (contra asset): store absolute value since student enters positive
    bsExpected[a]=a==='Accumulated Depreciation'?Math.abs(bal):Math.abs(bal);
    // Store sign separately for RE deficit check
    bsExpected[a+'_sign']=bal>=0?1:-1;
  });
  // Retained Earnings on the Balance Sheet is the ENDING balance (Net Income minus Dividends),
  // not the pre-closing ledger balance, which is still $0 until Phase 5 closes the books.
  const endRE=window._p6NetIncome-window._p6divBal;
  bsExpected['Retained Earnings']=Math.abs(endRE);
  bsExpected['Retained Earnings_sign']=endRE>=0?1:-1;

  // Asset section
  for(let i=0;i<assetAccounts.length;i++){
    const acct=document.getElementById(`bsa-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`bsa-amt-${i}`)?.value)||0;
    const row=document.getElementById(`bsa-row-${i}`);
    if(!acct&&amt===0){continue;}
    total++;
    const expectedAmt=bsExpected[acct];
    const acctCorrect=ASSETS.includes(acct)&&bsExpected.hasOwnProperty(acct);
    const amtCorrect=expectedAmt!==undefined&&Math.abs(amt-expectedAmt)<1;
    if(acctCorrect&&amtCorrect){
      correct++;
      if(row){row.style.background='#e8f5e9';row.style.outline='2px solid var(--green)';}
    } else {
      if(row){row.style.background='#fce4ec';row.style.outline='2px solid var(--red)';}
    }
  }

  // Liabilities + Equity section
  for(let i=0;i<liabEqAccounts.length;i++){
    const acct=document.getElementById(`bsle-dd-${i}`)?.value;
    const amt=parseFloat(document.getElementById(`bsle-amt-${i}`)?.value)||0;
    const row=document.getElementById(`bsle-row-${i}`);
    if(!acct&&amt===0){continue;}
    total++;
    const expectedAmt=bsExpected[acct];
    const acctCorrect=[...LIABS,'Common Stock','Retained Earnings'].includes(acct)&&bsExpected.hasOwnProperty(acct);
    const amtCorrect=expectedAmt!==undefined&&Math.abs(amt-expectedAmt)<1;
    if(acctCorrect&&amtCorrect){
      correct++;
      if(row){row.style.background='#e8f5e9';row.style.outline='2px solid var(--green)';}
    } else {
      if(row){row.style.background='#fce4ec';row.style.outline='2px solid var(--red)';}
    }
  }

  const pct=total>0?correct/total:0;
  const newFS=Math.round(pct*20);
  if(newFS>=(cycleScores.fs||0))cycleScores.fs=newFS;
  const fb=document.getElementById('fs-all-feedback');
  if(correct===total){
    fb.className='je-feedback correct show';
    fb.textContent=`All ${total} rows correct across all three statements!`;
  } else {
    fb.className='je-feedback wrong show';
    fb.textContent=`${correct} of ${total} rows correct. Rows highlighted in red need correction. Check account selection and dollar amount.`;
  }
  const nw=document.getElementById('fs-next-wrap');
  if(nw) nw.hidden=false;
}


