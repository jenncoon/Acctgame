<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Roboto+Slab:wght@400;600;700&display=swap" rel="stylesheet">
<style>
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }

:root {
  --violet:   #262D68;
  --violet-lt:#3a4490;
  --orange:   #FF9F1C;
  --orange-lt:#ffb84d;
  --green:    #0A713A;
  --green-lt: #0e9a50;
  --blue:     #1a5fa8;
  --blue-lt:  #2273c9;
  --yellow:   #D7DF23;
  --red:      #E51F36;
  --white:    #ffffff;
  --offwhite: #f8f6f0;
  --ink:      #1a1a2e;
  --mid:      #d0cfc8;
  --focus:    #FFD700;
  --prop-purple:#9b3ec0; --prop-lblue:#5aaedc; --prop-pink:#e84393;
  --prop-orange:#FF9F1C; --prop-red:#E51F36;   --prop-yellow:#b8b800;
  --prop-pgreen:#0A713A; --prop-dblue:#1a5fa8; --prop-rr:#222; --prop-util:#777;
}

* { box-sizing:border-box; margin:0; padding:0; }
body { background:linear-gradient(135deg,#0d1033 0%,#1a2060 50%,#0d1033 100%); min-height:100vh; font-family:Arial,sans-serif; color:var(--ink); overflow-x:hidden; }

.skip-link { position:absolute; top:-100px; left:0; background:var(--focus); color:var(--ink); font-weight:700; padding:10px 16px; z-index:9999; text-decoration:none; font-size:1rem; }
.skip-link:focus { top:0; }
:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
.sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }

/* ── SETUP ── */
.setup-screen { position:fixed; inset:0; z-index:600; background:linear-gradient(135deg,#0d1033 0%,#1a2060 50%,#0d1033 100%); display:flex; align-items:flex-start; justify-content:center; padding:40px 20px 20px; overflow-y:auto; }
.setup-screen[hidden] { display:none; }
.setup-box { background:var(--white); border-radius:16px; max-width:540px; width:100%; overflow:visible; box-shadow:0 20px 60px rgba(0,0,0,.6); }
.setup-header { background:var(--violet); padding:24px 32px; text-align:center; border-bottom:5px solid var(--orange); }
.setup-logo { font-family:'Bungee',cursive; font-size:clamp(1.1rem,3.5vw,1.7rem); color:var(--orange); display:block; letter-spacing:1px; margin-bottom:4px; }
.setup-sub { font-size:.875rem; color:rgba(255,255,255,.7); letter-spacing:2px; text-transform:uppercase; }
.setup-body { padding:24px 32px; }
.setup-section-label { font-size:.875rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--violet); display:block; margin-bottom:8px; margin-top:16px; }
.mode-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:6px; }
.mode-btn { padding:14px 10px; border-radius:10px; border:2px solid var(--mid); background:var(--offwhite); color:var(--ink); font-family:Arial,sans-serif; font-size:1rem; font-weight:700; cursor:pointer; transition:border-color .2s,background .2s; text-align:center; }
.mode-btn .mode-icon { font-size:1.6rem; display:block; margin-bottom:5px; }
.mode-btn .mode-sub { font-size:.875rem; color:#666; display:block; margin-top:2px; font-weight:400; }
.mode-btn:hover, .mode-btn[aria-pressed="true"] { border-color:var(--violet); background:#dde0f0; }
.name-row { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
.player-dot { width:12px; height:12px; border-radius:50%; flex-shrink:0; }
.p1-dot { background:var(--violet); } .p2-dot { background:var(--orange); }
.name-input { flex:1; border:2px solid var(--mid); border-radius:8px; padding:10px 14px; font-family:Arial,sans-serif; font-size:1rem; color:var(--ink); background:var(--offwhite); outline:none; }
.name-input:focus { border-color:var(--violet); }
.name-input.error { border-color:var(--red); }
.setup-rules { background:#f0f2ff; border-left:4px solid var(--violet); border-radius:0 8px 8px 0; padding:12px 16px; margin-bottom:14px; font-size:.875rem; line-height:1.7; color:#333; }
.setup-rules strong { color:var(--violet); }

/* Closing method question */
.closing-question { background:#fff3e0; border:2px solid var(--orange); border-radius:10px; padding:14px 16px; margin-top:14px; }
.closing-question p { font-size:1rem; font-weight:700; color:#5d3200; margin-bottom:10px; line-height:1.5; }
.closing-opts { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.closing-opt { padding:10px 12px; border-radius:8px; border:2px solid var(--mid); background:white; font-family:Arial,sans-serif; font-size:.875rem; font-weight:700; cursor:pointer; transition:border-color .2s,background .2s; text-align:center; color:var(--ink); }
.closing-opt:hover, .closing-opt[aria-pressed="true"] { border-color:var(--orange); background:#fff3e0; }
.closing-opt .co-icon { font-size:1.3rem; display:block; margin-bottom:4px; }
.closing-opt .co-sub { font-size:.875rem; color:#666; display:block; margin-top:2px; font-weight:400; }

.start-btn { width:100%; padding:14px; background:var(--violet); border:none; border-radius:10px; font-family:'Bungee',cursive; font-size:1rem; letter-spacing:1px; color:white; cursor:pointer; margin-top:18px; transition:background .2s,transform .15s; box-shadow:0 4px 16px rgba(38,45,104,.4); }
.start-btn:hover { background:var(--violet-lt); transform:translateY(-2px); }

/* ── GAME SCREEN ── */
#game-screen { display:none; }
#game-screen.active { display:block; }
.game-header { background:var(--violet); border-bottom:4px solid var(--orange); padding:10px 20px; display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
.game-title { font-family:'Bungee',cursive; font-size:clamp(.85rem,2.2vw,1.3rem); color:var(--orange); letter-spacing:1px; }
.game-title span { color:rgba(255,255,255,.6); font-size:.875rem; display:block; font-family:Arial,sans-serif; letter-spacing:2px; text-transform:uppercase; }
.scoreboard { display:flex; gap:10px; flex-wrap:wrap; }
.score-card { background:rgba(255,255,255,.1); border:2px solid rgba(255,255,255,.2); border-radius:10px; padding:7px 14px; min-width:130px; transition:border-color .3s,transform .3s; }
.score-card.active-player { border-color:var(--orange); transform:translateY(-2px); background:rgba(255,159,28,.15); }
.sc-name { font-size:.875rem; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:rgba(255,255,255,.7); display:block; }
.sc-cash { font-family:'Bungee',cursive; font-size:1rem; color:var(--orange); display:block; }
.sc-turn { font-size:.875rem; color:rgba(255,255,255,.75); display:block; }
.round-badge { background:var(--orange); color:var(--violet); font-family:'Bungee',cursive; font-size:.875rem; padding:6px 12px; border-radius:20px; white-space:nowrap; }

/* ── BOARD ── */
.board-wrapper { display:flex; justify-content:center; align-items:flex-start; padding:16px; gap:16px; flex-wrap:wrap; }
.monopoly-board { display:grid; grid-template-columns:78px repeat(9,58px) 78px; grid-template-rows:78px repeat(9,58px) 78px; border:3px solid #333; background:#c8e6c9; box-shadow:0 8px 32px rgba(0,0,0,.5); flex-shrink:0; }
.space { border:1px solid #333; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; background:#c8e6c9; font-size:.875rem; text-align:center; padding:2px; line-height:1.2; font-family:Arial,sans-serif; font-weight:700; color:#111; }
.space.corner { font-size:.875rem; }
.color-dot-legacy { position:absolute; }
.color-dot { position:absolute; top:3px; left:3px; width:11px; height:11px; border-radius:50%; border:1px solid rgba(0,0,0,.2); }
.strip-purple{background:var(--prop-purple)} .strip-lblue{background:var(--prop-lblue)} .strip-pink{background:var(--prop-pink)}
.strip-orange{background:var(--prop-orange)} .strip-red{background:var(--prop-red)} .strip-yellow{background:var(--prop-yellow)}
.strip-pgreen{background:var(--prop-pgreen)} .strip-dblue{background:var(--prop-dblue)} .strip-rr{background:var(--prop-rr)} .strip-util{background:var(--prop-util)}
.space-price { font-size:.65rem; color:#333; font-weight:400; display:block; }
.space-name { font-size:.65rem; line-height:1.2; font-weight:700; padding:0 2px; }
.space-icon { font-size:.875rem; }
.owned-p1::after { content:'📒'; position:absolute; bottom:2px; right:2px; font-size:.875rem; }
.owned-p2::after { content:'🧮'; position:absolute; bottom:2px; right:2px; font-size:.875rem; }
.token-p1,.token-p2 { position:absolute; font-size:1rem; z-index:10; animation:tokenBounce .4s ease; }
.token-p1 { bottom:3px; left:3px; } .token-p2 { bottom:3px; right:18px; }
@keyframes tokenBounce { 0%{transform:scale(.5) translateY(-10px);opacity:0} 60%{transform:scale(1.2) translateY(2px);opacity:1} 100%{transform:scale(1);opacity:1} }

/* CPU token */
.token-cpu { position:absolute; font-size:.875rem; z-index:9; top:3px; right:3px; animation:tokenBounce .4s ease; }

/* CPU notification */
/* CPU turn modal dialog */
.cpu-modal-overlay { position:fixed; inset:0; z-index:600; background:rgba(0,0,0,.55); display:flex; align-items:center; justify-content:center; padding:20px; }
.cpu-modal-overlay.hidden { display:none; }
.cpu-modal-box { background:var(--violet); border:3px solid var(--orange); border-radius:16px; padding:28px 32px; max-width:420px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,.6); }
.cpu-modal-title { font-family:'Bungee',cursive; font-size:1.1rem; color:var(--orange); display:block; margin-bottom:12px; }
.cpu-modal-text { font-size:1rem; color:white; line-height:1.7; margin-bottom:20px; }
.cpu-modal-close { width:100%; padding:14px 12px; min-height:44px; background:var(--orange); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:var(--violet); cursor:pointer; letter-spacing:1px; transition:background .2s; }
.cpu-modal-close:hover { background:var(--orange-lt); }
.cpu-modal-close:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
.board-center { grid-column:2/11; grid-row:2/11; background:#c8e6c9; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:10px; gap:6px; }
.center-title { font-family:'Bungee',cursive; font-size:clamp(.75rem,1.6vw,1.2rem); color:var(--violet); text-align:center; line-height:1.2; }
.center-sub { font-size:.875rem; color:#555; text-align:center; letter-spacing:1px; text-transform:uppercase; }
.die { width:44px; height:44px; background:white; border:3px solid var(--violet); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1.4rem; box-shadow:2px 2px 6px rgba(0,0,0,.2); }
.die.rolling { animation:dieRoll .5s ease; }
@keyframes dieRoll { 0%{transform:rotate(0deg) scale(1)} 25%{transform:rotate(-15deg) scale(1.1)} 50%{transform:rotate(15deg) scale(.9)} 75%{transform:rotate(-10deg) scale(1.05)} 100%{transform:rotate(0deg) scale(1)} }
.dice-area { display:flex; gap:10px; align-items:center; justify-content:center; }
.roll-btn { padding:12px 20px; min-height:44px; background:var(--violet); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; transition:background .2s,transform .15s; }
.roll-btn:hover:not(:disabled) { background:var(--violet-lt); transform:translateY(-1px); }
.roll-btn:disabled { opacity:.4; cursor:default; }
.status-msg { background:white; border:2px solid var(--violet); border-radius:8px; padding:7px 12px; font-size:.875rem; text-align:center; color:var(--ink); min-height:34px; line-height:1.4; max-width:250px; }

.sidebar { min-width:210px; max-width:250px; display:flex; flex-direction:column; gap:10px; }
.sidebar-card { background:white; border-radius:10px; overflow:hidden; box-shadow:0 4px 14px rgba(0,0,0,.2); }
.sidebar-header { background:var(--violet); color:white; font-family:'Bungee',cursive; font-size:.875rem; letter-spacing:1px; padding:7px 12px; }
.sidebar-body { padding:10px 12px; font-size:.875rem; line-height:1.6; }
.property-item { display:flex; align-items:center; gap:7px; padding:3px 0; border-bottom:1px solid var(--mid); font-size:.875rem; }
.property-item:last-child { border-bottom:none; }
.prop-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
.log-entry { font-size:.875rem; padding:3px 0; border-bottom:1px solid #eee; color:#444; line-height:1.4; }
.log-entry:last-child { border-bottom:none; }
.log-amt { font-weight:700; color:var(--violet); }

/* ── MODALS ── */
.overlay { display:none; position:fixed; inset:0; background:rgba(10,10,40,.88); z-index:300; justify-content:center; align-items:center; padding:16px; backdrop-filter:blur(4px); }
.overlay.active { display:flex; }
.modal-box { background:white; border-radius:16px; max-width:560px; width:100%; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.8); animation:modalPop .3s cubic-bezier(.34,1.56,.64,1); }
@keyframes modalPop { from{transform:scale(.85) translateY(16px);opacity:0} to{transform:scale(1) translateY(0);opacity:1} }
.modal-header { background:var(--violet); color:white; padding:16px 22px; border-radius:16px 16px 0 0; border-bottom:4px solid var(--orange); }
.modal-tag { font-size:.875rem; letter-spacing:3px; text-transform:uppercase; color:var(--orange); display:block; margin-bottom:3px; }
.modal-title { font-family:'Bungee',cursive; font-size:1rem; color:white; }
.modal-body { padding:18px 22px; }
.transaction-desc { background:#f0f2ff; border-left:4px solid var(--violet); border-radius:0 8px 8px 0; padding:11px 15px; margin-bottom:16px; font-size:1rem; line-height:1.6; color:#333; }
.transaction-desc strong { color:var(--violet); }
.je-label { font-size:.875rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--violet); display:block; margin-bottom:7px; }
.je-table { width:100%; border-collapse:collapse; margin-bottom:12px; font-size:.875rem; }
.je-table th { background:var(--violet); color:white; font-size:.875rem; letter-spacing:1px; text-transform:uppercase; padding:7px 10px; text-align:left; }
.je-table th:not(:first-child) { text-align:center; }
.je-table td { border:1px solid var(--mid); padding:6px 8px; background:var(--offwhite); vertical-align:middle; }
.je-table tr:nth-child(even) td { background:#f0f1f8; }
.je-table select { width:100%; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:Arial,sans-serif; font-size:.875rem; color:var(--ink); background:white; outline:none; }
.je-table select:focus { border-color:var(--violet); }
.je-table select.error,.je-table input.error { border-color:var(--red); }
.je-table input[type="number"] { width:88px; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:Arial,sans-serif; font-size:.875rem; color:var(--ink); background:white; text-align:right; outline:none; }
.je-table input[type="number"]:focus { border-color:var(--violet); }
.je-indent { padding-left:18px !important; }
.je-feedback { border-radius:8px; padding:10px 14px; margin-bottom:12px; font-size:.875rem; line-height:1.6; display:none; }
.je-feedback.show { display:block; }
.je-feedback.correct { background:#e8f5e9; border-left:4px solid var(--green); color:#1b5e20; }
.je-feedback.wrong   { background:#fce4ec; border-left:4px solid var(--red); color:#7f0000; }
.je-feedback.hint    { background:#fff3e0; border-left:4px solid var(--orange); color:#6d3b00; }
.attempt-note { font-size:.875rem; color:#666; text-align:center; margin-bottom:9px; }
.modal-btn { width:100%; padding:13px; min-height:44px; border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; letter-spacing:1px; cursor:pointer; transition:background .2s,transform .15s; margin-top:4px; }
.modal-btn.primary { background:var(--violet); color:white; }
.modal-btn.primary:hover { background:var(--violet-lt); }
.modal-btn.success { background:var(--green); color:white; }
.modal-btn.reveal { background:var(--orange); color:white; }
.modal-btn.secondary { background:#eee; color:#333; }
.modal-btn.secondary:hover { background:#ddd; }
.decision-btns { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.card-drawn { background:linear-gradient(135deg,#fff9e6,#fff3cc); border:2px solid var(--orange); border-radius:12px; padding:18px; text-align:center; margin-bottom:14px; }
.card-drawn.cc { background:linear-gradient(135deg,#e8f5e9,#d0f0d8); border-color:var(--green); }
.card-icon { font-size:2.2rem; display:block; margin-bottom:7px; }
.card-type { font-size:.875rem; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#888; display:block; margin-bottom:5px; }
.card-text { font-size:1rem; font-weight:700; color:var(--ink); line-height:1.5; }

/* ── CYCLE SCREEN ── */
#cycle-screen { display:none; }
#cycle-screen.active { display:block; min-height:100vh; }
.cycle-header { background:var(--violet); border-bottom:4px solid var(--orange); padding:12px 24px; }
.cycle-header h1 { font-family:'Bungee',cursive; font-size:clamp(.95rem,2.2vw,1.3rem); color:var(--orange); letter-spacing:1px; }
.cycle-header p { font-size:.875rem; color:rgba(255,255,255,.6); margin-top:2px; }
.phase-pips { display:flex; gap:0; align-items:center; padding:9px 24px; background:rgba(0,0,0,.3); overflow-x:auto; }
.pip { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Bungee',cursive; font-size:.875rem; border:2px solid; transition:all .3s; flex-shrink:0; }
.pip.locked   { background:rgba(255,255,255,.05); border-color:rgba(255,255,255,.75); color:rgba(255,255,255,.80); }
.pip.active   { background:var(--orange); border-color:var(--orange); color:var(--violet); box-shadow:0 0 10px rgba(255,159,28,.5); }
.pip.complete { background:var(--green); border-color:var(--green); color:white; cursor:pointer; }
.pip.complete:hover { background:var(--green-lt); }
.pip-line { width:18px; height:2px; background:rgba(255,255,255,.15); flex-shrink:0; }
.pip-line.lit { background:var(--green); }
.cycle-main { max-width:900px; margin:0 auto; padding:22px 20px 60px; }
.phase-card { background:white; border-radius:12px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,.15); margin-bottom:20px; }
.phase-card-header { background:var(--violet); padding:14px 22px; display:flex; align-items:center; justify-content:space-between; border-bottom:3px solid var(--orange); }
.phase-card-header h2 { font-family:'Bungee',cursive; font-size:clamp(.88rem,1.8vw,1.1rem); color:white; }
.phase-num-badge { background:var(--orange); color:var(--violet); font-family:'Bungee',cursive; font-size:1rem; width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.phase-card-body { padding:20px 22px; }
.phase-note { background:#f0f2ff; border-left:4px solid var(--violet); border-radius:0 8px 8px 0; padding:11px 15px; margin-bottom:16px; font-size:.875rem; line-height:1.7; color:#333; }
.phase-note strong { color:var(--violet); }

/* Tables */
.ledger-table { width:100%; border-collapse:collapse; margin-bottom:14px; font-size:.875rem; }
.ledger-table th { background:var(--violet); color:white; padding:7px 10px; text-align:left; font-size:.875rem; letter-spacing:1px; text-transform:uppercase; }
.ledger-table th:not(:first-child) { text-align:right; }
.ledger-table td { border:1px solid var(--mid); padding:5px 10px; background:var(--offwhite); color:var(--ink); }
.ledger-table tr:nth-child(even) td { background:#f0f1f8; }
.ledger-table td:not(:first-child) { text-align:right; font-family:'Roboto Slab',serif; }
.ledger-table .total-row td { background:var(--violet) !important; color:white !important; font-weight:700; }

/* T-accounts */
.t-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px; margin-bottom:14px; }
.t-account { border:2px solid var(--mid); border-radius:8px; overflow:hidden; background:var(--offwhite); }
.t-account-name { background:var(--violet); color:white; font-size:.875rem; font-weight:700; padding:5px 8px; text-align:center; text-transform:uppercase; }
.t-account-body { display:grid; grid-template-columns:1fr 1fr; }
.t-col { padding:6px 8px; min-height:52px; }
.t-col:first-child { border-right:2px solid var(--mid); }
.t-col-label { font-size:.875rem; color:#666; text-align:center; display:block; margin-bottom:3px; text-transform:uppercase; }
.t-col-val { font-family:'Roboto Slab',serif; font-size:.875rem; color:var(--ink); text-align:center; display:block; margin-bottom:2px; }
.t-balance-row { grid-column:1/-1; border-top:2px solid var(--mid); padding:6px 10px; background:#eef0f8; display:flex; flex-direction:column; gap:5px; }
.t-balance-label { font-size:.875rem; color:#333; text-transform:uppercase; font-weight:700; }
.t-balance-inputs { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
.t-balance-input { width:76px; border:1px solid var(--violet); border-radius:4px; padding:3px 6px; font-family:'Roboto Slab',serif; font-size:.875rem; color:var(--violet); text-align:right; outline:none; background:white; }
.t-balance-input:focus { border-color:var(--orange); }
.dc-select { border:1px solid var(--violet); border-radius:4px; padding:3px 4px; font-family:Arial,sans-serif; font-size:.875rem; outline:none; background:white; color:var(--ink); }
.dc-select:focus { border-color:var(--orange); }

/* Trial balance */
.tb-table { width:100%; border-collapse:collapse; margin-bottom:14px; font-size:.875rem; }
.tb-table th { background:var(--violet); color:white; padding:7px 12px; font-size:.875rem; letter-spacing:1px; text-transform:uppercase; }
.tb-table th:not(:first-child) { text-align:center; }
.tb-table td { border:1px solid var(--mid); padding:6px 10px; background:var(--offwhite); color:var(--ink); }
.tb-table tr:nth-child(even) td { background:#f0f1f8; }
.tb-table .total-row td { background:var(--violet) !important; color:white !important; font-weight:700; text-align:center; }
.tb-input { width:98px; border:1px solid var(--mid); border-radius:4px; padding:4px 6px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:white; color:var(--ink); }
.tb-input:focus { border-color:var(--violet); }
/* Remove browser spinner arrows from all number inputs */
input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
input[type=number] { -moz-appearance:textfield; appearance:textfield; }
.tb-total-input { width:105px; border:1px solid rgba(255,255,255,.5); border-radius:4px; padding:4px 6px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:rgba(255,255,255,.15); color:white; }
.tb-total-input:focus { border-color:white; }

/* Financial statement drag and drop */
.fs-build-area { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin-bottom:16px; }
.fs-pool { background:#f0f2ff; border:2px solid var(--violet); border-radius:10px; padding:12px; }
.fs-pool-title { font-family:'Bungee',cursive; font-size:.875rem; color:var(--violet); margin-bottom:10px; text-align:center; }
/* Financial Statement dropdown table layout */
.fs-stmt-block { background:white; border-radius:10px; border:2px solid var(--violet); margin-bottom:18px; overflow:hidden; }
.fs-stmt-title { background:var(--violet); color:white; font-family:'Bungee',cursive; font-size:1rem; padding:10px 16px; letter-spacing:1px; }
.fs-stmt-table { width:100%; border-collapse:collapse; }
.fs-stmt-table th { background:#f0f2ff; color:var(--violet); font-size:.875rem; font-weight:700; padding:8px 12px; text-align:left; border-bottom:2px solid var(--violet); }
.fs-stmt-table td { padding:6px 10px; border-bottom:1px solid #e0e0e0; vertical-align:middle; }
.fs-stmt-table tr:last-child td { border-bottom:none; }
.fs-total-row td { font-size:.875rem; padding:8px 10px; border-top:2px solid var(--violet); background:#f0f2ff; font-weight:700; }
.fs-dd { width:100%; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:Arial,sans-serif; font-size:.875rem; color:var(--ink); background:white; outline:none; min-height:36px; }
.fs-dd:focus { border-color:var(--violet); outline:2px solid var(--focus); outline-offset:2px; }
.fs-stmt-amt { width:110px; border:1px solid var(--mid); border-radius:4px; padding:5px 8px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:white; color:var(--ink); min-height:36px; }
.fs-stmt-amt:focus { border-color:var(--violet); outline:2px solid var(--focus); outline-offset:2px; }
.fs-calc-btn { margin:10px 16px 12px; padding:10px 20px; min-height:44px; background:#f0f2ff; border:2px solid var(--violet); border-radius:8px; font-family:Arial,sans-serif; font-size:.875rem; font-weight:700; color:var(--violet); cursor:pointer; transition:background .2s; }
.fs-calc-btn:hover { background:#dde2ff; }
.fs-calc-btn:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
.fs-drop-zone { background:#f8f9ff; border:2px dashed #aab; border-radius:10px; padding:10px; min-height:120px; display:flex; flex-direction:column; gap:6px; transition:border-color .2s,background .2s; }
.fs-drop-zone.drag-over { border-color:var(--orange); background:#fff9e6; }
.fs-drop-zone.wrong-flash { border-color:var(--red); background:#fce4ec; animation:wrongFlash .4s ease; }
@keyframes wrongFlash { 0%{background:#fce4ec} 50%{background:#ffcdd2} 100%{background:#fce4ec} }
.fs-drop-zone-label { font-size:.875rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#888; text-align:center; margin-bottom:6px; }
.acct-chip { background:white; border:2px solid var(--mid); border-radius:6px; padding:5px 10px; font-size:.875rem; font-weight:700; cursor:grab; user-select:none; transition:border-color .2s,box-shadow .2s; color:var(--ink); text-align:center; }
.acct-chip:hover { border-color:var(--violet); box-shadow:0 2px 8px rgba(38,45,104,.2); }
.acct-chip.dragging { opacity:.5; cursor:grabbing; }
.acct-chip.placed-correct { border-color:var(--green); background:#e8f5e9; cursor:default; }
.acct-chip.placed-wrong { border-color:var(--red); background:#fce4ec; }
.fs-amount-section { margin-top:14px; }
.fs-amount-section h4 { font-family:'Bungee',cursive; font-size:.875rem; color:var(--violet); margin-bottom:10px; }
.fs-amount-row { display:flex; align-items:center; gap:10px; margin-bottom:7px; font-size:.875rem; flex-wrap:wrap; }
.fs-amount-label { flex:1; min-width:140px; color:var(--ink); }
.fs-amount-input { width:100px; border:1px solid var(--mid); border-radius:4px; padding:5px 8px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:white; color:var(--ink); }
.fs-amount-input:focus { border-color:var(--violet); }
.fs-submit-btn { padding:10px 22px; background:var(--violet); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; margin-top:10px; transition:background .2s; }
.fs-submit-btn:hover { background:var(--violet-lt); }

/* Closing entries */
.closing-block { background:#f8f6f0; border:1px solid var(--mid); border-radius:8px; padding:13px 16px; margin-bottom:11px; }
.mc-opt { display:block; width:100%; text-align:left; background:white; border:2px solid var(--mid); border-radius:8px; padding:12px 16px; margin-bottom:8px; cursor:pointer; font-family:Arial,sans-serif; font-size:.95rem; color:var(--ink); min-height:44px; transition:border-color .2s, background .2s; }
.mc-opt:hover { border-color:var(--violet); }
.mc-opt.selected { border-color:var(--violet); background:#f1eefc; font-weight:600; }
.mc-opt.correct-final { border-color:var(--green); background:#e8f5e9; }
.mc-opt.wrong-final { border-color:var(--red); background:#fce4ec; }
.mc-opt:disabled { cursor:default; }
.closing-tbl { width:100%; border-collapse:collapse; margin-bottom:8px; }
.closing-tbl th { background:var(--violet); color:white; font-size:.875rem; font-weight:700; padding:8px 10px; text-align:left; }
.closing-tbl td { padding:6px 8px; border-bottom:1px solid var(--mid); vertical-align:middle; }
.closing-tbl tr:last-child td { border-bottom:none; }
.closing-tbl select { width:100%; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:Arial,sans-serif; font-size:.875rem; color:var(--ink); background:white; outline:none; min-height:36px; }
.closing-tbl select:focus { border-color:var(--violet); outline:2px solid var(--focus); outline-offset:2px; }
.closing-tbl-input { width:100%; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:white; color:var(--ink); min-height:36px; }
.closing-tbl-input:focus { border-color:var(--violet); outline:2px solid var(--focus); outline-offset:2px; }
.closing-hint { font-size:.875rem; color:#555; margin-bottom:10px; font-style:italic; }
.closing-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap; }
.closing-label { font-size:.875rem; min-width:52px; color:#444; }
.closing-select { flex:1; min-width:130px; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:Arial,sans-serif; font-size:.875rem; outline:none; background:white; color:var(--ink); }
.closing-select:focus { border-color:var(--violet); }
.closing-select.error { border-color:var(--red); }
.closing-amt { width:85px; border:1px solid var(--mid); border-radius:4px; padding:5px 6px; font-family:'Roboto Slab',serif; font-size:.875rem; text-align:right; outline:none; background:white; color:var(--ink); }
.closing-amt:focus { border-color:var(--violet); }
.zero-note { font-size:.75rem; color:#666; font-style:italic; margin-top:5px; display:block; }

/* CHECK section */
.check-section { background:var(--violet); border-radius:10px; padding:18px 20px; margin-top:20px; border:2px solid var(--orange); position:relative; text-align:center; }
.check-section::before { content:'CHECK'; position:absolute; top:-11px; left:50%; transform:translateX(-50%); font-family:'Bungee',cursive; font-size:.875rem; letter-spacing:3px; color:var(--orange); background:var(--violet); padding:0 10px; }
.check-title { font-family:'Bungee',cursive; font-size:1rem; color:var(--orange); margin:4px 0; }
.check-question { font-size:.875rem; color:rgba(255,255,255,.88); margin-bottom:13px; line-height:1.6; font-family:Arial,sans-serif; }
.check-input-row { display:flex; gap:10px; justify-content:center; align-items:center; flex-wrap:wrap; }
.check-input { border:2px solid var(--orange); border-radius:6px; padding:9px 14px; font-family:'Bungee',cursive; font-size:1.1rem; background:rgba(255,255,255,.1); color:white; width:150px; text-align:center; outline:none; letter-spacing:2px; }
.check-input::placeholder { color:rgba(255,255,255,.75); font-size:.875rem; letter-spacing:0; }
.check-input:focus { border-color:white; background:rgba(255,255,255,.15); }
.check-btn { padding:12px 20px; min-height:44px; background:var(--orange); border:none; border-radius:6px; font-family:'Bungee',cursive; font-size:1rem; color:var(--violet); cursor:pointer; letter-spacing:1px; transition:background .15s; }
.check-btn:hover { background:var(--orange-lt); }
.check-btn:disabled { opacity:.4; cursor:default; }
.check-feedback { margin-top:11px; border-radius:6px; padding:10px 13px; font-size:.875rem; line-height:1.6; display:none; text-align:left; }
.check-feedback.show { display:block; }
.check-feedback.correct  { background:rgba(10,113,58,.3);  border-left:4px solid #4caf50; color:#c8f0d8; }
.check-feedback.wrong    { background:rgba(229,31,54,.25); border-left:4px solid #ef9a9a; color:#ffd4d8; }
.check-feedback.revealed { background:rgba(255,159,28,.2); border-left:4px solid var(--orange); color:#fff3cd; }
.check-feedback strong { font-family:'Roboto Slab',serif; }
.check-attempts { font-size:.875rem; color:rgba(255,255,255,.85); margin-top:5px; text-align:center; }
.attempt-bar { display:flex; gap:4px; justify-content:center; margin-top:7px; }
.attempt-dot { width:9px; height:9px; border-radius:50%; transition:background .3s; }
.attempt-dot.used { background:rgba(229,31,54,.7); }
.attempt-dot.remaining { background:rgba(255,255,255,.6); }
@keyframes checkPulse { 0%{box-shadow:0 0 0 0 rgba(255,159,28,.6)} 70%{box-shadow:0 0 0 14px rgba(255,159,28,0)} 100%{box-shadow:0 0 0 0 rgba(255,159,28,0)} }
.check-section.unlocked { animation:checkPulse .6s ease-out; border-color:#4caf50; }
.next-phase-btn { display:none; margin:13px auto 0; padding:11px 26px; background:var(--green); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; transition:background .15s; }
.next-phase-btn:hover { background:var(--green-lt); }
.next-phase-btn.show { display:block; }

/* Viewer toggle */
.viewer-btn { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; background:#f0f2ff; border:2px solid var(--violet); border-radius:8px; font-family:Arial,sans-serif; font-size:.875rem; font-weight:700; color:var(--violet); cursor:pointer; margin-bottom:12px; margin-right:8px; transition:background .2s; }
.viewer-btn:hover { background:#dde0f0; }
.viewer-panel { background:#f8f8ff; border:1px solid var(--mid); border-radius:8px; padding:14px; margin-bottom:14px; display:none; }
.viewer-panel.open { display:block; }
.viewer-panel h4 { font-family:'Bungee',cursive; font-size:.875rem; color:var(--violet); margin-bottom:10px; }

/* ── REFLECTION GATE ── */
#reflection-gate-screen { display:none; }
#reflection-gate-screen.active { display:block; min-height:100vh; }
.gate-wrap { max-width:620px; margin:0 auto; padding:40px 20px; }
.gate-card { background:white; border-radius:16px; overflow:hidden; box-shadow:0 10px 40px rgba(0,0,0,.3); border:3px solid var(--orange); }
.gate-header { background:var(--violet); padding:24px 28px; border-bottom:4px solid var(--orange); text-align:center; }
.gate-header h2 { font-family:'Bungee',cursive; font-size:clamp(1.1rem,3vw,1.6rem); color:var(--orange); margin-bottom:6px; }
.gate-header p { font-size:.875rem; color:rgba(255,255,255,.7); }
.gate-body { padding:26px 28px; }
.gate-prompt { font-size:1rem; line-height:1.7; color:#333; margin-bottom:16px; }
.gate-textarea { width:100%; min-height:120px; border:2px solid var(--mid); border-radius:8px; padding:12px; font-family:Arial,sans-serif; font-size:1rem; line-height:1.6; resize:vertical; outline:none; color:var(--ink); }
.gate-textarea:focus { border-color:var(--violet); }
.gate-char { font-size:.875rem; margin-top:5px; margin-bottom:14px; }
.gate-submit-btn { width:100%; padding:13px; background:var(--violet); border:none; border-radius:10px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; transition:background .2s,transform .15s; }
.gate-submit-btn:hover:not(:disabled) { background:var(--violet-lt); transform:translateY(-1px); }
.gate-submit-btn:disabled { opacity:.4; cursor:default; }
.gate-error { color:var(--red); font-size:.875rem; margin-top:6px; display:none; }
.gate-error.show { display:block; }

/* ── COMPLETE SCREEN ── */
#complete-screen { display:none; }
#complete-screen.active { display:block; min-height:100vh; }
.complete-wrap { max-width:700px; margin:0 auto; padding:36px 20px; text-align:center; }
.complete-box { background:white; border-radius:16px; overflow:hidden; box-shadow:0 10px 40px rgba(0,0,0,.3); border:3px solid var(--orange); }
.complete-banner { background:var(--violet); padding:28px 24px; border-bottom:4px solid var(--orange); }
.complete-banner h2 { font-family:'Bungee',cursive; font-size:clamp(1.3rem,3.5vw,1.9rem); color:var(--orange); margin-bottom:7px; }
.complete-banner p { font-size:.875rem; color:rgba(255,255,255,.7); }
.complete-body { padding:26px 26px; }
.score-display { font-family:'Bungee',cursive; font-size:3.2rem; color:var(--violet); display:block; margin:10px 0; }
.score-label { font-size:.875rem; letter-spacing:2px; text-transform:uppercase; color:#888; }
.score-breakdown { display:flex; flex-direction:column; gap:5px; margin:14px 0; text-align:left; }
.score-row { display:flex; justify-content:space-between; align-items:center; padding:7px 13px; border-radius:6px; font-size:.875rem; background:var(--offwhite); border:1px solid var(--mid); }
.score-row-label { color:#444; }
.score-row-val { font-family:'Roboto Slab',serif; font-weight:700; color:var(--violet); }
.badge-msg { font-size:.875rem; color:#555; line-height:1.6; margin:14px 0; padding:12px 16px; background:#fff3e0; border:2px solid var(--orange); border-radius:10px; }
.download-btn { display:inline-block; padding:11px 26px; background:var(--orange); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:var(--violet); cursor:pointer; text-decoration:none; letter-spacing:1px; transition:background .2s; margin:6px; }
.download-btn:hover { background:var(--orange-lt); }
.replay-btn { display:inline-block; padding:11px 26px; background:var(--violet); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; transition:background .2s; margin:6px; }
.replay-btn:hover { background:var(--violet-lt); }
.exit-scorm-btn { display:inline-block; padding:11px 24px; min-height:44px; background:var(--green); border:none; border-radius:8px; font-family:'Bungee',cursive; font-size:1rem; color:white; cursor:pointer; letter-spacing:1px; transition:background .2s; margin:6px; }
.exit-scorm-btn:hover { background:var(--green-lt); }
.exit-scorm-btn:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
.scorm-msg { font-size:.875rem; color:var(--green); font-weight:700; margin:12px 0; padding:9px 14px; background:#e8f5e9; border:1px solid var(--green); border-radius:8px; }

@media (max-width:780px) {
  .monopoly-board { grid-template-columns:60px repeat(9,44px) 60px; grid-template-rows:60px repeat(9,44px) 60px; }
  .board-wrapper { flex-direction:column; align-items:center; }
  .sidebar { max-width:100%; min-width:0; width:100%; }
  .fs-build-area { grid-template-columns:1fr; }
}
@media (max-width:540px) {
  .monopoly-board { grid-template-columns:48px repeat(9,34px) 48px; grid-template-rows:48px repeat(9,34px) 48px; }
  .space { font-size:.65rem; }
}

.level-selector-wrap { margin-top:16px; margin-bottom:4px; }
.level-selector-label { font-size:1rem; font-weight:700; color:var(--violet); letter-spacing:1px; margin-bottom:10px; display:block; }
.level-opt { display:flex; align-items:center; gap:14px; background:#1a2060; border:2px solid rgba(255,255,255,.2); border-radius:10px; padding:14px 16px; margin-bottom:10px; cursor:pointer; transition:border-color .2s, background .2s; text-align:left; width:100%; min-height:52px; touch-action:manipulation; color:white; font-family:Arial,sans-serif; }
.level-opt:hover, .level-opt.selected { border-color:#FF9F1C; background:#262D68; }
.level-opt:hover .level-badge, .level-opt.selected .level-badge { background:#FF9F1C; color:#262D68; }
.level-badge { min-width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.2); color:white; font-family:'Bungee',cursive; font-size:1.1rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .2s, color .2s; }
.level-info { display:flex; flex-direction:column; gap:3px; }
.level-title { font-family:'Bungee',cursive; font-size:1rem; color:white; letter-spacing:.5px; }
.level-desc { font-size:.875rem; color:rgba(255,255,255,.85); line-height:1.4; }
.level-txn { font-size:.8rem; color:#FF9F1C; margin-top:2px; font-weight:700; }
</style>
