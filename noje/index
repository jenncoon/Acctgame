<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<div id="sr-announce" class="sr-only" aria-live="polite" aria-atomic="true"></div>
<div id="sr-alert"    class="sr-only" aria-live="assertive" aria-atomic="true"></div>

<!-- ══ SETUP ══ -->
<div class="setup-screen" id="setup-screen" role="main">
  <div class="setup-box">
    <div class="setup-header">
      <span class="setup-logo">Boardwalk Books LLC</span>
      <span class="setup-sub">Crestwood Heights</span>
      <span style="display:block;font-size:.75rem;color:rgba(255,255,255,.80);margin-top:6px;letter-spacing:.5px;">&#169; 2026 Jennifer Coon. All rights reserved. Free for educational use. Not for resale.</span>
    </div>
    <div class="setup-body">
      <div class="setup-rules"><strong>Your Mission:</strong> You are the accountant for Boardwalk Books LLC, a real estate company investing across Crestwood Heights. Choose your level, record every transaction, then follow the data through adjustments and into the financial statements.</div>

      <span class="setup-section-label">Your Name</span>
      <div class="name-row"><div class="player-dot p1-dot" aria-hidden="true"></div><input type="text" class="name-input" id="p1-name" placeholder="Enter your name" autocomplete="given-name" aria-label="Your name" aria-required="true"></div>
      <div class="setup-rules" style="margin-top:10px;background:#e8f5e9;border-left-color:#0A713A;">
        <strong>Your opponent:</strong> City Properties Inc. 🏢 plays automatically after each of your turns. When they land on your properties you record rent received. When you land on theirs you pay rent. All transactions are yours to record.
      </div>

      <div class="level-selector-wrap">
        <p class="level-selector-label">Select Your Level</p>
        <div role="radiogroup" aria-label="Game level selection">
          <button type="button" class="level-opt selected" id="level-btn-1" aria-pressed="true" onclick="setLevel(1)">
            <span class="level-badge" aria-hidden="true">1</span>
            <span class="level-info">
              <span class="level-title">Level 1: Getting Started</span>
              <span class="level-desc">1 round around the board. All property landings require a purchase transaction.</span>
              <span class="level-txn">Approx. 8-12 transactions</span>
            </span>
