}
const P5_MC_CHOICES=[
  {text:'Revenue, expense, and dividend balances reset to zero, and net income moves into Retained Earnings.',correct:true},
  {text:'Revenue, expense, and dividend balances double in size to carry extra activity into next period.',correct:false},
  {text:'Revenue, expense, and dividend accounts are deleted permanently from the chart of accounts.',correct:false},
  {text:'Revenue, expense, and dividend balances carry over unchanged into the next accounting period.',correct:false},
];
function buildP5MCOptions(){
  const shuffled=shuffle(P5_MC_CHOICES);
  const letters=['a','b','c','d'];
  window._p5MCCorrectLetter=null;
  const html=shuffled.map((opt,i)=>{
    const letter=letters[i];
    if(opt.correct) window._p5MCCorrectLetter=letter;
    return `<button type="button" class="mc-opt" id="p5-mc-${letter}" aria-pressed="false" onclick="selectP5MC('${letter}')">${opt.text}</button>`;
  }).join('\n        ');
  return html;
}
function selectP5MC(letter){
  ['a','b','c','d'].forEach(l=>{
    const btn=document.getElementById(`p5-mc-${l}`);
    if(!btn||btn.disabled)return;
    btn.className='mc-opt'+(l===letter?' selected':'');
    btn.setAttribute('aria-pressed',l===letter?'true':'false');
  });
  window._p5MCSelected=letter;
  document.getElementById('p5-mc-submit').disabled=false;
}
function checkP5MC(){
  if(!window._p5MCSelected)return;
  window._p5MCAttempt++;
  const fb=document.getElementById('p5-mc-feedback');
  const correctLetter=window._p5MCCorrectLetter;
  const correct=window._p5MCSelected===correctLetter;
  ['a','b','c','d'].forEach(l=>{const btn=document.getElementById(`p5-mc-${l}`);if(btn)btn.disabled=true;});
  if(correct){
    document.getElementById(`p5-mc-${correctLetter}`).className='mc-opt correct-final';
    fb.className='je-feedback correct show';
    fb.innerHTML='<strong>Correct!</strong> Closing entries zero out the temporary accounts and roll the net effect into Retained Earnings.';
    document.getElementById('p5-mc-submit').style.display='none';
    document.getElementById('p5-next-wrap').hidden=false;
  } else if(window._p5MCAttempt>=2){
    document.getElementById(`p5-mc-${window._p5MCSelected}`).className='mc-opt wrong-final';
    document.getElementById(`p5-mc-${correctLetter}`).className='mc-opt correct-final';
    fb.className='je-feedback hint show';
    fb.innerHTML='<strong>Correct answer:</strong> Revenue, expense, and dividend balances reset to zero, and the net effect moves into Retained Earnings.';
    document.getElementById('p5-mc-submit').style.display='none';
    document.getElementById('p5-next-wrap').hidden=false;
  } else {
    document.getElementById(`p5-mc-${window._p5MCSelected}`).className='mc-opt wrong-final';
    fb.className='je-feedback wrong show';
    fb.textContent='Not quite. Think about what "temporary" accounts means for next period, and try again.';
    // re-enable for second attempt
    ['a','b','c','d'].forEach(l=>{const btn=document.getElementById(`p5-mc-${l}`);if(btn){btn.disabled=false;if(l!==window._p5MCSelected)btn.className='mc-opt';}});
    window._p5MCSelected=null;
    document.getElementById('p5-mc-submit').disabled=true;
  }
}


// CHECK SYSTEM
const MAX_ATT=5;
function buildCheck(phase,q){return`<div class="check-section" id="check-${phase}"><div class="check-title">Phase ${phase} Check</div><div class="check-question">${q}</div><div class="check-input-row"><input type="number" class="check-input" id="v${phase}-input" placeholder="?" aria-label="Phase ${phase} answer" min="0"><button class="check-btn" id="v${phase}-btn" onclick="checkPhase(${phase})">Check</button></div><div class="check-feedback" id="v${phase}-feedback" aria-live="polite" aria-atomic="true"></div><div class="attempt-bar" id="v${phase}-bar"></div><div class="check-attempts" id="v${phase}-attempts"></div><button class="next-phase-btn" id="v${phase}-next" onclick="${phase<TOTAL_PHASES?'advanceTo('+(phase+1)+')':'goToReflection()'}">${phase<TOTAL_PHASES?'Proceed to Phase '+(phase+1)+': '+PHASE_NAMES[phase]+' &rarr;':'Close the Books &rarr;'}</button></div>`;}
function buildBar(phase){const bar=document.getElementById(`v${phase}-bar`);if(!bar)return;bar.innerHTML='';for(let i=0;i<MAX_ATT;i++){const d=document.createElement('div');d.className='attempt-dot remaining';d.id=`v${phase}-dot-${i}`;bar.appendChild(d);}}
function updateBar(phase,used){for(let i=0;i<MAX_ATT;i++){const d=document.getElementById(`v${phase}-dot-${i}`);if(d)d.className='attempt-dot '+(i<used?'used':'remaining');}}
function checkPhase(phase){
  if(!cycleVaultAttempts[phase])cycleVaultAttempts[phase]=0;
  cycleVaultAttempts[phase]++;
  const input=document.getElementById(`v${phase}-input`),fb=document.getElementById(`v${phase}-feedback`),nextBtn=document.getElementById(`v${phase}-next`),btn=document.getElementById(`v${phase}-btn`);
  const att=cycleVaultAttempts[phase], raw=parseFloat(input?.value);
  if(isNaN(raw)){fb.className='check-feedback wrong show';fb.textContent='Please enter a number.';cycleVaultAttempts[phase]--;return;}
  updateBar(phase,att);
  document.getElementById(`v${phase}-attempts`).textContent=`Attempt ${att} of ${MAX_ATT}`;
  const correct=vaultAnswers[phase];
  if(Math.abs(raw-correct)<1){
    fb.className='check-feedback correct show';fb.innerHTML=`<strong>Correct!</strong> The answer is $${typeof correct==='number'?correct.toLocaleString():correct}.`;
    if(input)input.disabled=true;if(btn)btn.disabled=true;
    document.getElementById(`check-${phase}`)?.classList.add('unlocked');nextBtn?.classList.add('show');
    const pts=att===1?10:att<=2?8:att<=3?6:att<=4?4:2;
    scorePhase(phase,pts);
  } else {
    if(att>=MAX_ATT){
      fb.className='check-feedback revealed show';fb.innerHTML=`<strong>Answer:</strong> The correct answer is <strong>$${correct.toLocaleString()}</strong>. Review the notes above and proceed.`;
      if(input)input.disabled=true;if(btn)btn.disabled=true;nextBtn?.classList.add('show');scorePhase(phase,0);
    } else {
      fb.className='check-feedback wrong show';fb.innerHTML=`<strong>Not quite.</strong> ${getHint(phase,att)} You have ${MAX_ATT-att} attempt(s) remaining.`;
    }
  }
}
function scorePhase(phase,pts){
  if(phase===2){if(pts>=(cycleScores.adj||0))cycleScores.adj=pts;}
  else if(phase===4){if(pts>=(cycleScores.fs||0))cycleScores.fs=pts;}
}
function getHint(phase,att){
  const pc=Object.entries(ownership).filter(([,o])=>o==='player').length;
  const h={
    1:['Count each numbered row in the table above.','Include every transaction from both rounds.','Each row represents one complete transaction.','Scroll up to recount if needed.'],
    2:[`Depreciation is $50 per property you own. You own ${pc} ${pc===1?'property':'properties'}.`,`$50 x ${pc} = $${adjDepreciation}.`,'Multiply the number of properties you own by $50.','This is the amount Depreciation Expense increases by.'],
    4:['Net Income = Total Revenues minus Total Expenses.','Add all revenue account balances, then subtract all expense account balances.','Use the accounts you classified as Income Statement items in Phase 3.','If expenses exceed revenues, Net Income will be negative (net loss).'],
  };
  const arr=h[phase]||['Review your work carefully.'];return arr[Math.min(att-1,arr.length-1)];
}
function advanceTo(phase){currentCyclePhase=phase;renderPhase(phase);}

// REFLECTION GATE
function goToReflection(){
  cycleScores.completion=10;cycleScores.je=Math.min(Math.round(cycleScores.je),30);
  finalScore=Math.min(Object.values(cycleScores).reduce((s,v)=>s+v,0),CYCLE_MAX_SCORE);
  document.getElementById('cycle-screen').classList.remove('active');
  document.getElementById('reflection-gate-screen').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  const ta=document.getElementById('gate-reflection'),charEl=document.getElementById('gate-char-count');
  ta.addEventListener('input',()=>{const len=ta.value.length;charEl.textContent=`${len} / 40 characters minimum`;charEl.style.color=len>=40?'var(--green)':'#888';});
}
function submitReflection(){
  const ta=document.getElementById('gate-reflection'),err=document.getElementById('gate-error');
  reflectionText=ta.value.trim();
  if(reflectionText.length<40){err.classList.add('show');ta.focus();return;}
  err.classList.remove('show'); showResults();
}

// RESULTS
function showResults(){
  document.getElementById('reflection-gate-screen').classList.remove('active');
  document.getElementById('complete-screen').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  document.getElementById('final-score-display').textContent=`${finalScore}/${CYCLE_MAX_SCORE}`;
  document.getElementById('score-breakdown').innerHTML=[
    ['Transactions (gameplay)',cycleScores.je,30],['Adjusting Entries (accounts)',cycleScores.adjCards,10],
    ['Adjusting Entries (calculation)',cycleScores.adj,10],['Sort to Statements',cycleScores.classify,20],
    ['Financial Statements',cycleScores.fs,20],['Completion',cycleScores.completion,10],
  ].map(([l,e,mx])=>`<div class="score-row"><span class="score-row-label">${l}</span><span class="score-row-val">${e}/${mx}</span></div>`).join('');
  // Show appropriate completion message
  document.getElementById('badge-msg').style.display='block';
  if(scormOK){
    SCORM.save(finalScore);
    const sm=document.getElementById('scorm-msg');
    sm.style.display='block';
    sm.textContent=`Score saved: ${finalScore}/${CYCLE_MAX_SCORE}. Download your reflection card before leaving this page.`;
    const exitBtn=document.getElementById('exit-scorm-btn');
    if(exitBtn) exitBtn.style.display='inline-block';
    const exitNote=document.getElementById('exit-note');
    if(exitNote) exitNote.style.display='block';
  }
  buildReflectionCard();
}

// REFLECTION CARD PNG
function buildReflectionCard(){
  const canvas=document.getElementById('reflection-canvas');
  const W=700,H=560; canvas.width=W; canvas.height=H;
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#262D68'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#FF9F1C'; ctx.fillRect(0,0,W,8); ctx.fillRect(0,H-8,W,8);
  ctx.fillStyle='#FF9F1C'; ctx.font='bold 26px Arial'; ctx.textAlign='center';
  ctx.fillText('Boardwalk Books LLC',W/2,50);
  ctx.fillStyle='rgba(255,255,255,0.7)'; ctx.font='12px Arial';
  ctx.fillText('Crestwood Heights \u2022 Accounting Cycle Game',W/2,70);
  ctx.fillStyle='rgba(255,159,28,0.4)'; ctx.fillRect(40,82,W-80,1);
  ctx.fillStyle='white'; ctx.font='bold 17px Arial'; ctx.textAlign='left';
  ctx.fillText(`Student: ${playerName}`,48,108);
  ctx.fillStyle='#FF9F1C'; ctx.font='bold 20px Arial'; ctx.textAlign='right';
  ctx.fillText(`Score: ${finalScore}/${CYCLE_MAX_SCORE}`,W-48,108);
  ctx.fillStyle='rgba(255,255,255,0.6)'; ctx.font='11px Arial'; ctx.textAlign='left';
  ctx.fillText(`Date: ${new Date().toLocaleDateString()}`,48,126);
  const levelLabel=gameLevel===1?'Level 1: Getting Started':gameLevel===2?'Level 2: Building Equity':'Level 3: Full Portfolio';
  const stdLabel=accountingStandard==='ifrs'?'IFRS':'US GAAP';
  ctx.fillStyle='rgba(255,255,255,0.6)'; ctx.font='11px Arial'; ctx.textAlign='left';
  ctx.fillText(`Level: ${levelLabel}  \u2022  Standard: ${stdLabel}`,48,142);
  ctx.fillStyle='rgba(255,159,28,0.3)'; ctx.fillRect(40,154,W-80,1);

  ctx.fillStyle='#FF9F1C'; ctx.font='bold 12px Arial'; ctx.textAlign='left';
  ctx.fillText('SCORE BREAKDOWN',48,176);
  const breakdown=[
    ['Transactions (gameplay)',cycleScores.je,30],
    ['Adjusting Entries (accounts)',cycleScores.adjCards,10],
    ['Adjusting Entries (calculation)',cycleScores.adj,10],
    ['Sort to Statements',cycleScores.classify,20],
    ['Financial Statements',cycleScores.fs,20],
    ['Completion',cycleScores.completion,10],
  ];
  let by=196;
  breakdown.forEach(([label,earned,max])=>{
    ctx.fillStyle='rgba(255,255,255,0.85)'; ctx.font='13px Arial'; ctx.textAlign='left';
    ctx.fillText(label,48,by);
    ctx.fillStyle='white'; ctx.font='bold 13px Arial'; ctx.textAlign='right';
    ctx.fillText(`${earned}/${max}`,W-48,by);
    by+=19;
  });
  ctx.fillStyle='rgba(255,159,28,0.3)'; ctx.fillRect(40,by+6,W-80,1);

  ctx.fillStyle='#FF9F1C'; ctx.font='bold 12px Arial'; ctx.textAlign='left';
  ctx.fillText('REFLECTION',48,by+28);
  ctx.fillStyle='white'; ctx.font='13px Arial';
  const maxW=W-96,lineH=20; let y=by+46,line='';
  reflectionText.split(' ').forEach(word=>{const test=line?line+' '+word:word;if(ctx.measureText(test).width>maxW&&line){if(y>H-46){ctx.fillText('...',48,y);return;}ctx.fillText(line,48,y);line=word;y+=lineH;}else line=test;});
  if(y<=H-46&&line) ctx.fillText(line,48,y);
  ctx.fillStyle='rgba(255,255,255,0.45)'; ctx.font='10px Arial'; ctx.textAlign='center';
  ctx.fillText('Submit this reflection card to your instructor per course instructions.',W/2,H-28);
  ctx.fillStyle='rgba(255,255,255,.35)'; ctx.font='9px Arial';
  ctx.fillText('© 2026 Jennifer Coon. All rights reserved. Free for educational use. Not for resale.',W/2,H-10);
  const dataURL=canvas.toDataURL('image/png');
  const dlBtn=document.getElementById('download-card-btn');
  dlBtn.href=dataURL; dlBtn.style.display='inline-block';
}

// KEYBOARD
document.addEventListener('keydown',function(e){
  // Escape closes CPU modal
  if(e.key==='Escape'){
    const modal=document.getElementById('cpu-modal');
    if(modal&&!modal.classList.contains('hidden')){closeCPUModal();return;}
  }
  if(e.key!=='Enter')return;
  const a=document.activeElement;
  if(a&&a.classList.contains('check-input')){const m=a.id.match(/v(\d+)-input/);if(m)checkPhase(parseInt(m[1]));}
});

// SCORM deferred finish: called when student clicks exit or navigates away
function exitSCORM(){
  SCORM.finish();
  // Update UI
  const btn=document.getElementById('exit-scorm-btn');
  if(btn){btn.textContent='✓ Score Submitted';btn.disabled=true;btn.style.opacity='.6';}
  const note=document.getElementById('exit-note');
  if(note){note.textContent='Your score has been submitted. You may now close this window.';note.style.color='var(--green)';}
}

// Fallback: call LMSFinish if student closes or navigates away without clicking exit
// Also warn the student if they try to leave mid-game before downloading their reflection card
window.addEventListener('beforeunload',function(e){
  SCORM.finish();
  if(playerRoundCount>0&&!gameOver){
    e.preventDefault();
    e.returnValue='You have unsaved game progress. If you leave now, your progress will be lost.';
  }
});
