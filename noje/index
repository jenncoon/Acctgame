// DICE
const DIE_FACES=['⚀','⚁','⚂','⚃','⚄','⚅'];
function rollDice(){
  if(gameOver)return;
  document.getElementById('roll-btn').disabled=true;
  const d1=Math.floor(Math.random()*6)+1, d2=Math.floor(Math.random()*6)+1;
  const e1=document.getElementById('die1'), e2=document.getElementById('die2');
  e1.classList.add('rolling'); e2.classList.add('rolling');
  setTimeout(()=>{
    e1.textContent=DIE_FACES[d1-1]; e2.textContent=DIE_FACES[d2-1];
    e1.classList.remove('rolling'); e2.classList.remove('rolling');
    ann(`${playerName} rolled ${d1} and ${d2}. Total: ${d1+d2}.`);
    movePlayer(d1+d2);
  },550);
}

// PLAYER MOVEMENT
function movePlayer(steps){
  const oldPos=playerPos, newPos=(oldPos+steps)%40, passedGO=(oldPos+steps)>=40;
  playerPos=newPos; renderTokens();
  if(passedGO&&newPos!==0){
    playerRoundCount++; updateRoundBadge();
    showJE({type:'go',desc:`<strong>${playerName} passed Fiscal Year Start!</strong> Collect $200 service revenue.`,
      correctEntries:[{account:'Cash',debit:200,credit:0},{account:'Service Revenue',debit:0,credit:200}],
      onComplete:()=>{playerCash+=200;renderScoreboard();addToLog('Passed Fiscal Year Start: +$200');landOnSpace(newPos);}});
  } else if(newPos===0){
    playerRoundCount++; updateRoundBadge();
    showJE({type:'go',desc:`<strong>${playerName} landed on Fiscal Year Start!</strong> Collect $200 service revenue.`,
      correctEntries:[{account:'Cash',debit:200,credit:0},{account:'Service Revenue',debit:0,credit:200}],
      onComplete:()=>{playerCash+=200;renderScoreboard();addToLog('Landed on Fiscal Year Start: +$200');endTurn();}});
  } else { landOnSpace(newPos); }
}

function landOnSpace(pos){
  const sp=SPACES[pos];
  updateStatus(`${playerName} landed on ${sp.name}.`);
  switch(sp.type){
    case 'property': handleProperty(sp); break;
    case 'propmgmt': handlePropMgmt(); break;
    case 'utility':  handleUtility(sp);  break;
    case 'tax':
      showJE({type:'tax',desc:`<strong>Income Tax:</strong> ${playerName} must pay $100.`,
        correctEntries:[{account:'Tax Expense',debit:100,credit:0},{account:'Cash',debit:0,credit:100}],
        onComplete:()=>{playerCash-=100;renderScoreboard();addToLog('Tax: -$100');endTurn();}});break;
    case 'luxtax':
      showJE({type:'luxtax',desc:`<strong>Luxury Tax:</strong> ${playerName} must pay $75.`,
        correctEntries:[{account:'Luxury Tax Expense',debit:75,credit:0},{account:'Cash',debit:0,credit:75}],
        onComplete:()=>{playerCash-=75;renderScoreboard();addToLog('Luxury Tax: -$75');endTurn();}});break;
    case 'risk': drawRiskCard(); break;
    case 'ledger':     drawLedgerCard();     break;
    case 'jail': case 'parking':
      updateStatus(`${playerName} is at ${sp.name}. No transaction.`);setTimeout(endTurn,1200);break;
    case 'gotojail':
      playerPos=10; renderTokens(); updateStatus(`${playerName} is under IRS Audit!`);setTimeout(endTurn,1500);break;
    default: endTurn();
  }
}

function handleProperty(sp){
  const owner=ownership[sp.id];
  if(owner===undefined){
    if(playerCash>=sp.price){
      const forcedPurchase=(gameLevel===1||gameLevel===3);
      if(forcedPurchase){
        showJE({type:'buy',desc:`<strong>Purchase ${sp.name}:</strong> Record the purchase for $${sp.price} cash.`,
          correctEntries:[{account:'Property Asset',debit:sp.price,credit:0},{account:'Cash',debit:0,credit:sp.price}],
          onComplete:()=>{playerCash-=sp.price;ownership[sp.id]='player';renderOwnership();renderScoreboard();updatePropertiesList();addToLog(`Bought ${sp.name}: -$${sp.price}`);endTurn();}});
      } else {
        const dotColor=sp.color&&PROP_CSS[sp.color]?`var(${PROP_CSS[sp.color]})`:'#999';
        document.getElementById('decision-title').innerHTML=`<span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:${dotColor};vertical-align:middle;margin-right:8px;"></span>Buy ${sp.name}?`;
        document.getElementById('decision-desc').innerHTML=`<strong>${sp.name}</strong> available for <strong>$${sp.price}</strong>. You have $${playerCash.toLocaleString()}.`;
        document.getElementById('decision-overlay').classList.add('active');
      }
    } else {updateStatus(`${playerName} can't afford ${sp.name}.`);setTimeout(endTurn,1500);}
  } else if(owner==='player'){
    updateStatus(`You own ${sp.name}. No transaction.`);setTimeout(endTurn,1200);
  } else {
    showJE({type:'rent-pay',desc:`<strong>${playerName} owes rent!</strong> ${sp.name} is owned by City Properties Inc. Pay $${sp.rent}.`,
      correctEntries:[{account:'Rent Expense',debit:sp.rent,credit:0},{account:'Cash',debit:0,credit:sp.rent}],
      onComplete:()=>{playerCash-=sp.rent;cpuCash+=sp.rent;renderScoreboard();addToLog(`Rent to CPI: -$${sp.rent}`);endTurn();}});
  }
}

