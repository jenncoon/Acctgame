// TURN MANAGEMENT
function endTurn(){
  if(playerRoundCount>=maxRounds&&cpuRoundCount>=maxRounds){startCycle();return;}
  runCPUTurn();
}

// CPU PLAYER
function cpuRoll(){
  const playerSpaces=Object.entries(ownership).filter(([,o])=>o==='player').map(([s])=>parseInt(s));
  if(playerSpaces.length>0&&Math.random()<0.65){
    const target=playerSpaces[Math.floor(Math.random()*playerSpaces.length)];
    let dist=(target-cpuPos+40)%40;
    if(dist>=2&&dist<=12) return dist;
  }
  return Math.floor(Math.random()*6)+1+Math.floor(Math.random()*6)+1;
}

function showCPUNotify(text){
  return new Promise(resolve=>{
    const modal=document.getElementById('cpu-modal');
    document.getElementById('cpu-modal-text').textContent=text;
    modal.classList.remove('hidden');
    // Store resolve so close button can call it
    window._cpuModalResolve=resolve;
    // Focus the close button for keyboard/screen reader users
    setTimeout(()=>document.getElementById('cpu-modal-close-btn')?.focus(),50);
  });
}
function closeCPUModal(){
  document.getElementById('cpu-modal').classList.add('hidden');
  if(window._cpuModalResolve){window._cpuModalResolve();window._cpuModalResolve=null;}
}

async function runCPUTurn(){
  if(cpuRoundCount>=maxRounds){
    document.getElementById('roll-btn').disabled=false;
    updateStatus(`${playerName}'s turn. Roll the dice!`);
    return;
  }
  await showCPUNotify('City Properties Inc. is taking their turn...');
  const steps=cpuRoll();
  const oldPos=cpuPos, newPos=(oldPos+steps)%40, passedGO=(oldPos+steps)>=40;
  cpuPos=newPos; renderTokens();
  if(passedGO){cpuRoundCount++;cpuCash+=200;renderScoreboard();await showCPUNotify(`City Properties Inc. passed GO and collected $200.`);}
  await processCPUSpace(SPACES[newPos]);
}

async function processCPUSpace(sp){
  const owner=ownership[sp.id];
  if(sp.type==='property'||sp.type==='utility'){
    if(owner===undefined){
      if(cpuCash>=sp.price){
        ownership[sp.id]='cpu'; cpuCash-=sp.price;
        renderOwnership(); renderScoreboard(); addToLog(`🏢 CPI bought ${sp.name}`);
        await showCPUNotify(`City Properties Inc. purchased ${sp.name} for $${sp.price}.`);
      } else {
        await showCPUNotify(`City Properties Inc. landed on ${sp.name} but can't afford it ($${cpuCash} available).`);
      }
    } else if(owner==='player'){
      cpuCash-=sp.rent; renderScoreboard();
      await showCPUNotify(`City Properties Inc. landed on YOUR ${sp.name}! They owe you $${sp.rent} rent. Record the transaction.`);
      showJE({type:'rent-recv',
        desc:`<strong>City Properties Inc. landed on ${sp.name}!</strong> They owe you $${sp.rent} rent. Record the cash received and rental revenue.`,
        correctEntries:[{account:'Cash',debit:sp.rent,credit:0},{account:'Rental Revenue',debit:0,credit:sp.rent}],
        onComplete:()=>{playerCash+=sp.rent;renderScoreboard();addToLog(`Rent from CPI: +$${sp.rent}`);afterCPUTurn();}});
      return;
    } else {
      await showCPUNotify(`City Properties Inc. landed on their own ${sp.name}.`);
    }
  } else if(sp.type==='tax'){cpuCash-=100;renderScoreboard();await showCPUNotify(`City Properties Inc. paid $100 in taxes.`);}
  else if(sp.type==='luxtax'){cpuCash-=75;renderScoreboard();await showCPUNotify(`City Properties Inc. paid $75 luxury tax.`);}
  else if(sp.type==='gotojail'){cpuPos=10;renderTokens();await showCPUNotify(`City Properties Inc. is under IRS Audit!`);}
  else if(sp.type==='go'){cpuCash+=200;cpuRoundCount++;renderScoreboard();await showCPUNotify(`City Properties Inc. landed on GO. Collected $200.`);}
  else if(sp.type==='chance'||sp.type==='cc'){await showCPUNotify(`City Properties Inc. drew a ${sp.type==='risk'?'Risk':'Ledger'} card.`);}
  else {await showCPUNotify(`City Properties Inc. landed on ${sp.name}.`);}
  afterCPUTurn();
}

function afterCPUTurn(){
  if(playerRoundCount>=maxRounds&&cpuRoundCount>=maxRounds){startCycle();return;}
  document.getElementById('roll-btn').disabled=false;
  updateStatus(`${playerName}'s turn. Roll the dice!`);
  renderScoreboard();
}

