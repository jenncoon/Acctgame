// Which financial statement an account's ending balance belongs on.
function classificationFor(account){
  if(account==='Dividends') return 'RE';
  if(account==='Retained Earnings'||account==='Common Stock') return 'EQBS';
  const a=ACCOUNTS.find(x=>x.name===account);
  if(!a) return null;
  if(a.group==='Revenue'||a.group==='Expenses') return 'IS';
  if(a.group==='Assets'||a.group==='Liabilities') return 'BS';
  return null;
}
